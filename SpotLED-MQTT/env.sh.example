#!/bin/sh
# Copy to env.sh and edit for your installation.

# Leave blank for NOAA-only mode; MQTT is needed for Home Assistant weather or alerts.
export MQTT_HOST=""
export MQTT_PORT="1883"
export MQTT_USERNAME=""
export MQTT_PASSWORD=""
export MQTT_NOTIFY_TOPIC=""
export MQTT_WEATHER_TOPIC="<home-assistant-weather-state-topic>"
export MQTT_SPEED_TOPIC="<speed-results-topic>"
export SPOTLED_DEVICE_NAME="SpotLED_AB12"
export WEATHER_UNIT="F"
export NOAA_WEATHER_STATION="<station-id>"
export CLOCK_TIMEZONE="<timezone-name>"
export CLOCKTEMP_INDOOR_URL="http://<tc001-host>/api/v1/device"
export MQTT_TLS="false"
export SPOTLED_TEXT_EFFECT="scroll"
export SPOTLED_TEXT_MODE="native"
export SPOTLED_TEXT_SPEED="normal"
export LOG_LEVEL="INFO"
