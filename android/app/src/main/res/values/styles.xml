<resources>
    <style name="AppThemeSystem" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/spotled_accent</item>
        <item name="android:statusBarColor">@color/spotled_light_status</item>
        <item name="android:navigationBarColor">@color/spotled_light_status</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="AppThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/spotled_accent</item>
        <item name="android:statusBarColor">@color/spotled_light_status</item>
        <item name="android:navigationBarColor">@color/spotled_light_status</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/spotled_accent</item>
        <item name="android:statusBarColor">@color/spotled_dark_status</item>
        <item name="android:navigationBarColor">@color/spotled_dark_status</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
